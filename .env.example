# PostgreSQL. Locally: `pnpm db:up` starts one on port 5434. In production use
# the Railway connection URL.
DATABASE_URL="postgresql://cms:cms_dev_password@localhost:5434/coaching_cms?schema=public"
# Max connections per app instance (keep small on serverless hosts).
DB_POOL_MAX="5"

# Generate with: openssl rand -base64 32   (use a different value in production)
BETTER_AUTH_SECRET="replace-me"
# The public URL of the app. Login requests from any other origin are rejected.
BETTER_AUTH_URL="http://localhost:3000"

# First admin account, created by `pnpm db:seed`. Change the password after
# first login (Settings → Change your password).
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# Optional: integration tests default to DATABASE_URL's database + "_test".
# TEST_DATABASE_URL="postgresql://cms:cms_dev_password@localhost:5434/coaching_cms_test"
